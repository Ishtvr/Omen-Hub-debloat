import { Theme } from "theme.slint";

export struct KeyCap { label: string, x: float, y: float, w: float, h: float, zone: int, group: int }

export component KeyboardPreview inherits Rectangle {
    in property <[KeyCap]> keys;
    in property <[color]> colors;
    in property <int> selected;
    in property <bool> enabled: true;
    callback selected-group(int);
    height: min(480px, self.width * 0.33);
    horizontal-stretch: 1;
    background: Theme.surface;
    border-radius: 8px;
    for cap in root.keys: key-cap := Rectangle {
        accessible-role: none;
        accessible-label: cap.label;
        x: 10px + cap.x * (parent.width - 20px) / 20.5;
        y: 10px + cap.y * (parent.height - 20px) / 6.5;
        width: cap.w * (parent.width - 20px) / 20.5 - 3px;
        height: cap.h * (parent.height - 20px) / 6.5 - 3px;
        background: Theme.control;
        border-radius: 4px;
        border-width: 1px;
        border-color: cap.group == root.selected ? Theme.accent : Theme.line;
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: 3px;
            background: root.colors[cap.zone].with-alpha(0.22);
        }

        Rectangle {
            x: 4px;
            y: parent.height - 4px;
            width: max(0px, parent.width - 8px);
            height: 2px;
            border-radius: 1px;
            background: root.colors[cap.zone];
        }

        Text {
            text: cap.label;
            font-size: clamp(root.width / 64, 10px, 16px);
            color: Theme.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        TouchArea {
            enabled: root.enabled;
            clicked => { root.selected-group(cap.group); }
        }
    }
}
