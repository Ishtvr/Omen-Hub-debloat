export global Theme {
    pure callback tr(string) -> string;
    in property <bool> dark: true;
    in property <color> canvas: #202127;
    in property <color> surface: #27282E;
    in property <color> control: #2E2F34;
    in property <color> hover: #37383E;
    in property <color> line: #424349;
    in property <color> ink: #F2F3F5;
    in property <color> muted: #B3B4B7;
    in property <color> quiet: #74757A;
    in property <color> accent: #7C87F8;
    in property <color> on-accent: #000000;
    out property <color> good: dark ? #71D5A6 : #147347;
    out property <color> warning: dark ? #E5C18A : #765000;
    out property <color> error: dark ? #F3A1AF : #A21635;
    out property <length> control-height: 36px;
    out property <length> field-width: 276px;
    out property <length> action-width: 128px;
}
