// Original app controls; native Slint input retains caret, IME and edit history.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component BrightnessSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <bool> show-fill: true;
    in property <bool> hue-track;
    out property <bool> has-focus: focus.has-focus;
    in property <bool> enabled: true;
    callback edited(float);
    forward-focus: focus;
    height: Theme.control-height;
    min-width: 80px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 1;
    accessible-action-set-value(v) => { if v.is-float() { root.change(v.to-float()); } }
    accessible-action-increment => { root.change(root.value + 1); }
    accessible-action-decrement => { root.change(root.value - 1); }
    // The host owns value; local assignment would detach its binding.
    function change(v: float) { if root.enabled { root.edited(round(clamp(v, root.minimum, root.maximum))); } }
    private property <float> fraction: clamp((root.value - root.minimum) / max(1, root.maximum - root.minimum), 0, 1);
    Rectangle {
        x: 8px;
        y: (parent.height - 3px) / 2;
        width: parent.width - 16px;
        height: 3px;
        border-radius: 2px;
        background: Theme.line;
        visible: !root.hue-track;
    }

    for segment in 6: Rectangle {
        private property <[color]> colors: [#FF0000, #FFFF00, #00FF00, #00FFFF, #0000FF, #FF00FF, #FF0000];
        visible: root.hue-track;
        x: 8px + segment * (parent.width - 16px) / 6;
        y: (parent.height - 6px) / 2;
        width: (parent.width - 16px) / 6 + 1px;
        height: 6px;
        background: @linear-gradient(90deg, self.colors[segment] 0%, self.colors[segment + 1] 100%);
    }

    Rectangle {
        x: 8px;
        y: (parent.height - 3px) / 2;
        width: (parent.width - 16px) * root.fraction;
        height: 3px;
        background: Theme.accent;
        visible: root.show-fill;
    }

    Rectangle {
        x: (parent.width - 16px) * root.fraction;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? Theme.accent : Theme.quiet;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.ink;
    }

    area := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => { if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { focus.focus(); root.change(root.minimum + (self.mouse-x - 8px) / max(1px, self.width - 16px) * (root.maximum - root.minimum)); } }
        moved => { if self.pressed { root.change(root.minimum + (self.mouse-x - 8px) / max(1px, self.width - 16px) * (root.maximum - root.minimum)); } }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.change(root.value - 1); return accept; }
            if e.text == Key.RightArrow || e.text == Key.UpArrow { root.change(root.value + 1); return accept; }
            if e.text == Key.Home { root.change(root.minimum); return accept; }
            if e.text == Key.End { root.change(root.maximum); return accept; }
            return reject;
        }
    }
}

export component LineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-action-set-value(v) => { if root.enabled { root.text = v; root.edited(v); } }
    accessible-action-set-selection-offsets(a, f) => { input.set-selection-offsets(a, f); }
    min-width: 60px;
    preferred-width: Theme.field-width;
    max-width: Theme.field-width;
    height: Theme.control-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    background: root.enabled ? Theme.control : Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.enabled && input.has-focus ? Theme.accent : Theme.line;
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
        color: Theme.muted;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    ContextMenuArea {
        enabled: root.enabled;
        Menu {
            MenuItem {
                title: Theme.tr("ui.undo");
                activated => { input.undo(); }
            }

            MenuItem {
                title: Theme.tr("ui.redo");
                activated => { input.redo(); }
            }

            MenuSeparator { }

            MenuItem {
                title: Theme.tr("edit.cut");
                activated => { input.cut(); }
            }

            MenuItem {
                title: Theme.tr("edit.copy");
                activated => { input.copy(); }
            }

            MenuItem {
                title: Theme.tr("edit.paste");
                activated => { input.paste(); }
            }

            MenuItem {
                title: Theme.tr("edit.select_all");
                activated => { input.select-all(); }
            }
        }
    }

    Rectangle {
        x: 12px;
        width: max(0px, parent.width - 24px);
        clip: true;
        input := TextInput {
            property <length> offset;
            x: min(0px, max(parent.width - self.width, self.offset));
            width: max(parent.width, self.preferred-width + self.text-cursor-width);
            height: parent.height;
            enabled: root.enabled;
            color: root.enabled ? Theme.ink : Theme.quiet;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            single-line: true;
            vertical-alignment: center;
            accessible-role: none;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
            cursor-position-changed(p) => {
                if p.x + self.offset < 0px { self.offset = -p.x; }
                else if p.x + self.offset > parent.width - self.text-cursor-width {
                    self.offset = parent.width - self.text-cursor-width - p.x;
                }
            }
        }
    }

    @children
}

export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    forward-focus: focus;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggle(); }
    height: max(Theme.control-height, label.preferred-height + 8px);
    min-width: 24px + label.min-width;
    horizontal-stretch: 1;
    border-radius: 6px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    function toggle() { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    box := Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        border-radius: 4px;
        background: root.checked ? Theme.accent : Theme.control;
        border-width: 1px;
        border-color: root.enabled ? root.checked ? Theme.accent : Theme.muted : Theme.quiet;
        Path {
            visible: root.checked;
            x: 3px;
            y: 4px;
            width: 11px;
            height: 8px;
            stroke: Theme.on-accent;
            stroke-width: 1.8px;
            commands: "M 0 3 L 4 7 L 10 0";
        }
    }

    label := Text {
        x: 30px;
        width: max(0px, parent.width - 30px);
        height: parent.height;
        text: root.text;
        color: root.enabled ? Theme.ink : Theme.quiet;
        vertical-alignment: center;
        wrap: word-wrap;
        accessible-role: none;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.toggle(); }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(e) => { if e.text == " " { root.toggle(); return accept; } return reject; }
    }
}

export component ComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index;
    out property <string> current-value: root.model[root.current-index];
    private property <bool> opened;
    private property <length> popup-scroll;
    private property <int> pending-index;
    callback selected(string);
    forward-focus: focus;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.opened;
    accessible-value: root.current-value;
    accessible-action-expand => { root.open(); }
    min-width: 80px;
    preferred-width: Theme.field-width;
    max-width: Theme.field-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.control-height;
    background: !root.enabled ? Theme.surface : touch.has-hover ? Theme.hover : Theme.control;
    border-radius: 6px;
    border-width: 1px;
    border-color: (focus.has-focus || root.opened) && root.enabled ? Theme.accent : Theme.line;
    function choose(index: int) {
        if root.enabled && root.model.length > 0 {
            root.current-index = clamp(index, 0, root.model.length - 1);
            root.selected(root.current-value);
        }
    }
    function open() {
        if !root.enabled || root.model.length == 0 { return; }
        root.opened = true;
        root.pending-index = root.current-index;
        popup.show();
    }
    function keep-visible(top: length, item-height: length, page-height: length) {
        if page-height <= 0px { return; }
        let offset = -root.popup-scroll;
        if top < offset || item-height > page-height { root.popup-scroll = -top; }
        else if top + item-height > offset + page-height { root.popup-scroll = page-height - top - item-height; }
    }
    function close() { popup.close(); root.opened = false; focus.focus(); }
    Text {
        x: 12px;
        width: parent.width - 42px;
        text: root.current-value;
        color: root.enabled ? Theme.ink : Theme.quiet;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    Path {
        x: parent.width - 25px;
        y: (parent.height - 5px) / 2;
        width: 10px;
        height: 5px;
        stroke: root.enabled ? Theme.muted : Theme.quiet;
        stroke-width: 1.5px;
        commands: "M 0 0 L 5 5 L 10 0";
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.open(); }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " || (e.modifiers.alt && e.text == Key.DownArrow) { root.open(); return accept; }
            if e.text == Key.DownArrow { root.choose(root.current-index + 1); return accept; }
            if e.text == Key.UpArrow { root.choose(root.current-index - 1); return accept; }
            if e.text == Key.Home { root.choose(0); return accept; }
            if e.text == Key.End { root.choose(root.model.length - 1); return accept; }
            return reject;
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: min(7, root.model.length) * Theme.control-height + 8px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            focus-changed-event => { root.opened = self.has-focus; }
            key-pressed(e) => {
                if e.text == Key.Return || e.text == " " { root.choose(root.pending-index); root.close(); return accept; }
                if e.text == Key.Escape { root.close(); return accept; }
                if e.text == Key.Tab || e.text == Key.Backtab { root.close(); return reject; }
                if e.text == Key.DownArrow { root.pending-index = min(root.pending-index + 1, root.model.length - 1); }
                else if e.text == Key.UpArrow { root.pending-index = max(root.pending-index - 1, 0); }
                else if e.text == Key.Home { root.pending-index = 0; }
                else if e.text == Key.End { root.pending-index = root.model.length - 1; }
                else { return reject; }
                return accept;
            }
            Rectangle {
                background: Theme.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.line;
            }

            list := ScrollView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-width: self.visible-width;
                content-y <=> root.popup-scroll;
                VerticalLayout {
                    spacing: 0px;
                    for value[index] in root.model: option := Rectangle {
                        private property <bool> pending: root.opened && index == root.pending-index;
                        private property <length> item-top: self.y;
                        private property <length> item-height: self.height;
                        private property <length> page-height: list.visible-height;
                        function reveal() { if self.pending { root.keep-visible(self.item-top, self.item-height, self.page-height); } }
                        init => { self.reveal(); }
                        changed pending => { self.reveal(); }
                        changed item-top => { self.reveal(); }
                        changed item-height => { self.reveal(); }
                        changed page-height => { self.reveal(); }
                        height: max(Theme.control-height, choice.preferred-height + 16px);
                        background: index == root.pending-index ? Theme.hover : hit.has-hover ? Theme.control : transparent;
                        border-radius: 4px;
                        accessible-role: list-item;
                        accessible-label: value;
                        accessible-item-selectable: true;
                        accessible-item-selected: index == root.pending-index;
                        accessible-action-default => { root.choose(index); root.close(); }
                        choice := Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: value;
                            color: Theme.ink;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            accessible-role: none;
                        }

                        hit := TouchArea {
                            clicked => { root.choose(index); root.close(); }
                        }
                    }
                }
            }
        }
    }
}
